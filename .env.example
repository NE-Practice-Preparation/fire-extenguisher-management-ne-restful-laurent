POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="ne_exam"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_password_here"
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/ne_exam?schema=public"
PORT="3001"
WEB_ORIGIN="http://localhost:3000"
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="86400"

# Single seeded ADMIN account (the only admin in the system)
SEED_ADMIN_EMAIL="admin@ne.rw"
SEED_ADMIN_PASSWORD="Admin@123"
SEED_ADMIN_FIRST_NAME="System"
SEED_ADMIN_LAST_NAME="Administrator"

NEXT_PUBLIC_API_URL="http://localhost:3001/api"

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_FAMILY="4"
SMTP_USER="smtp_user"
