generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  email            String    @unique
  passwordHash     String
  role             UserRole  @default(USER)
  isActive         Boolean   @default(true)
  passwordSetAt    DateTime?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdInspections  Inspection[] @relation("CreatedInspections")
  assignedInspections Inspection[] @relation("AssignedInspections")
  maintenanceActivities MaintenanceActivity[] @relation("LoggedMaintenanceActivities")

  @@index([role])
}

enum UserRole {
  ADMIN
  INSPECTOR
  USER
}

model FireExtinguisher {
  id               String             @id @default(cuid())
  serialNumber     String             @unique
  location         String
  type             ExtinguisherType
  size             String
  installationDate DateTime
  expiryDate       DateTime
  status           ExtinguisherStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  inspections Inspection[]

  @@index([type])
  @@index([status])
}

model Inspection {
  id                  String           @id @default(cuid())
  extinguisherId      String
  extinguisher        FireExtinguisher @relation(fields: [extinguisherId], references: [id], onDelete: Cascade)
  scheduledDate       DateTime
  scheduledTime       String
  status              InspectionStatus @default(SCHEDULED)
  notes               String?
  assignedInspectorId String?
  assignedInspector   User?            @relation("AssignedInspections", fields: [assignedInspectorId], references: [id], onDelete: SetNull)
  createdById         String
  createdBy           User             @relation("CreatedInspections", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  maintenanceActivities MaintenanceActivity[]

  @@index([status])
  @@index([extinguisherId])
  @@index([assignedInspectorId])
  @@index([createdById])
}

model MaintenanceActivity {
  id              String     @id @default(cuid())
  inspectionId    String
  inspection      Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectorId     String?
  inspector       User?      @relation("LoggedMaintenanceActivities", fields: [inspectorId], references: [id], onDelete: SetNull)
  actionsTaken    String
  actionDate      DateTime
  conditionsNoted String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([inspectionId])
  @@index([inspectorId])
  @@index([actionDate])
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  OVERDUE
}

enum ExtinguisherType {
  WATER
  CO2
  FOAM
  DRY_CHEMICAL
}

enum ExtinguisherStatus {
  ACTIVE
  EXPIRED
  MAINTENANCE_REQUIRED
  OUT_OF_SERVICE
}
